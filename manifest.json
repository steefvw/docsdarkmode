{
  "manifest_version": 3,
  "name": "Google Docs & Sheets Dark Mode",
  "version": "1.1.0",
  "description": "Sleek, customizable dark mode for Google Docs and Google Sheets with multiple themes, dark/light canvas toggle, and keyboard shortcuts.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Google Docs & Sheets Dark Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles/dark-mode.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://docs.google.com/drivesharing/*",
        "https://drive.google.com/drivesharing/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles/dark-mode.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Toggle Google Docs Dark Mode on or off"
    },
    "toggle-page-invert": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Toggle between dark page and light page"
    }
  }
}
